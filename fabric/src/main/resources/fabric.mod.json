{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthors}"
  ],
  "contact": {
    "homepage": "https://github.com/cotrin8672",
    "sources": "https://github.com/cotrin8672/ItemIndicator"
  },
  "license": "${modLicense}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "value": "io.github.cotrin8672.itemindicator.fabric.client.ItemIndicatorFabricClient",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "${modId}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabricKotlinVersion}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
